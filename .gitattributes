# Force LF line endings on the artifact and tooling so the manifest's
# sha256 hashes verify identically on Windows and Unix checkouts.
*.html        text eol=lf
*.mjs         text eol=lf
*.py          text eol=lf
*.md          text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
LICENSE       text eol=lf
.editorconfig text eol=lf

# Upstream, this file also carries the export curation that decides which paths ship.
# This repository is the result of that curation, so only the line-ending law travels
# with it.
